DISPATCH_PORT=4400
DISPATCH_DATA=./dispatch-data
DISPATCH_ENV_FILE=.env

# Optional service/runtime settings for local providers and notifications:
# DISPATCH_PUBLIC_URL=http://localhost:4400
# DISPATCH_GRAFT=0                    # disable automatic per-ticket code indexing
# DISPATCH_GRAFT_TIMEOUT_SEC=120      # max seconds spent refreshing before a run
# TELEGRAM_BOT_TOKEN=   # from @BotFather — see README "Notifications (Telegram)"
# TELEGRAM_CHAT_ID=     # from @userinfobot, or set via SETTINGS -> NOTIFY instead
